{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "phoenix": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@arizeai/phoenix-mcp@latest",
        "--baseUrl",
        "http://localhost:6006"
      ],
      "enabled": true
    }
  }
}
