# Copy this file to .env and fill in the values. Never commit the filled-in .env
# (.gitignore already blocks it).

# --- OpenAI (model inference + embeddings) -------------------------------------
# The Quick Win assumes an OpenAI key. Other OpenAI-compatible providers (DeepSeek,
# OpenRouter) also need OPENAI_BASE_URL set.
OPENAI_API_KEY=

# --- Neon Postgres (the system of record) --------------------------------------
# Two forms of the SAME database URL, used by different components:
#
#   DATABASE_URL       plain  postgresql://...   — used by asyncpg pools:
#                      the customer-data MCP server (server.py) and the audit
#                      pool (audit.py). Use the POOLED endpoint (...-pooler...).
#
#   NEON_DATABASE_URL  the    postgresql+asyncpg://...  form — used by the SDK's
#                      SQLAlchemySession (chat.py) for conversation turns.
#
# Get them from `get_connection_string` (Neon MCP) or the Neon console. Same DB.
DATABASE_URL=
NEON_DATABASE_URL=

# --- Optional ------------------------------------------------------------------
# Override where the Worker reaches the running customer-data MCP server.
# Defaults to http://127.0.0.1:8000/mcp if unset.
# CUSTOMER_DATA_MCP_URL=http://127.0.0.1:8000/mcp
