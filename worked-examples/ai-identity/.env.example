# AuthCo SSO server config. Copy to .env and fill in. Never commit real secrets.
# verify.sh will auto-generate a .env with fresh secrets if this file is absent.

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Registered OAuth client used by notes-consumer/ and verify.sh ("Notes" app).
NOTES_CLIENT_ID=notes-app
# Generate with: openssl rand -base64 32
NOTES_CLIENT_SECRET=
NOTES_REDIRECT_URI=http://localhost:4567/callback

# Test credentials used only by verify.sh (a real deployment never stores these).
TEST_USER_EMAIL=ac1-user@example.com
TEST_USER_PASSWORD=Sup3rSecret-Passw0rd!
NOTES_USER_EMAIL=notes-user@example.com
NOTES_USER_PASSWORD=Sup3rSecret-Passw0rd!
