# Paperclip course instance — connection facts from the REFERENCE run (NO SECRETS).
# These are illustrative values captured when this worked solution was produced
# (2026-06-02). When you run the course yourself, your IDs and paths will differ;
# importing northwind-company/ creates fresh IDs. Treat this as "what mine looked like."
#
# NOTE: PAPERCLIP_API_URL is the BARE host, no /api suffix.
#       Routes are formed as $PAPERCLIP_API_URL/api/<route>.

PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_UI_URL=http://127.0.0.1:3100
PAPERCLIP_VERSION=2026.529.0

# Paths are shown relative to this folder; yours will be absolute on your machine.
PAPERCLIP_DATA_DIR=./paperclip-data
PAPERCLIP_CONFIG=./paperclip-data/instances/default/config.json
PAPERCLIP_LOGS=./paperclip-data/instances/default/logs

# Embedded Postgres (read-only audit queries; loopback default creds):
#   postgresql://paperclip:paperclip@127.0.0.1:54329/paperclip
PAPERCLIP_PG_PORT=54329

# Bind mode: loopback (trust-based, no bootstrap API key issued).

# --- Northwind company (created 2026-06-02) ---
PAPERCLIP_COMPANY_ID=c67406b3-53af-4ff1-8437-f45ba19a0d9c
PAPERCLIP_COMPANY_NAME=Northwind
PAPERCLIP_ISSUE_PREFIX=NOR
PAPERCLIP_GOAL_ID=a0d2b54b-5bd1-43bd-897a-f1a4bccfb573
# budget ceiling: 2000 cents ($20/mo); hire-approval gate: ON

# --- CEO (first agent) ---
PAPERCLIP_CEO_AGENT_ID=321efe54-0470-40c1-a0e3-82074f164784
# adapter opencode_local / openai/gpt-5.4-mini (keyless via OpenAI oauth); budget $5/mo

# --- Northwind Site project (first project) ---
PAPERCLIP_SITE_PROJECT_ID=50a0536d-c187-464a-8a89-eb34c557b15d
PAPERCLIP_SITE_WORKSPACE_ID=a0c5fb28-d481-4537-9590-ff9f7ee260aa
PAPERCLIP_SITE_CWD=./northwind-site
# primary workspace, local_path (no repoUrl); linked to the newsletter goal
