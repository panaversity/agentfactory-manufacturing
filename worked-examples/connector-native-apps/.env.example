# Copy to .env and fill in. NEVER commit .env. NEVER paste these into a chat.

# --- Postgres (Neon) — the two-table state store (Concept 5) ---
DATABASE_URL=postgresql://user:pass@host/db

# --- Your gateway's own identity (Concept 8) ---
# The canonical public URL of THIS server. Tokens must be audience-bound to it (RFC 8707).
RESOURCE_URL=https://mcp.myapp.com

# --- The authorization server you trust (Concept 8) ---
# Standard track: your AS issuer + JWKS — hosted (Clerk / Auth0 / Stytch) or self-hosted (Better Auth).
# Beginner track: point these at the local mock service (see mock_auth/README.md), e.g.
#   AUTH_ISSUER=http://localhost:9000
#   AUTH_JWKS_URL=http://localhost:9000/jwks.json
AUTH_ISSUER=https://auth.myapp.com
AUTH_JWKS_URL=https://auth.myapp.com/jwks.json

# --- Signs the short-lived session tokens begin_session issues (Concept 10) ---
# Generate a random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_SECRET=change-me
