# Copy this file to .env and fill in your keys.
# .env is gitignored; never commit it.

# Your OpenAI API key (or another model provider your agent supports)
OPENAI_API_KEY=

# Inngest local dev mode: keep this set for the dev server (no signing key needed)
INNGEST_DEV=1

# Neon Postgres connection string (from the Neon dashboard or the Neon MCP)
# Looks like: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
