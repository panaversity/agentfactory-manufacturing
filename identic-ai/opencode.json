{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "paperclip": {
      "type": "local",
      "command": ["npx", "-y", "@paperclipai/mcp-server"],
      "enabled": true,
      "environment": {
        "PAPERCLIP_API_URL": "http://127.0.0.1:3100",
        "PAPERCLIP_API_KEY": "local-trusted"
      }
    }
  }
}
