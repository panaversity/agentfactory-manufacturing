# Keys this base needs. Copy to .env and fill in; never commit the filled-in .env.
#
# OPENAI_API_KEY  the Worker's model calls (the same key your Course #4 Worker uses).
#   OpenAI-compatible providers (DeepSeek, OpenRouter) also set OPENAI_BASE_URL.
# INNGEST_DEV     set to 1 so the Inngest SDK runs in local dev mode without a signing key.
#   (Equivalently, pass is_production=False on the client. Do one; with neither, the SDK
#   defaults to production/Cloud mode and nothing connects to your local dev server.)
#
# The Worker you bring in carries its own DATABASE_URL / NEON_DATABASE_URL in its .env;
# copy those across too, or let the agent re-fetch the connection string via Neon MCP.
OPENAI_API_KEY=
INNGEST_DEV=1
