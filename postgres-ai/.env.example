# The only key this base needs. Copy this file to .env and paste your key in.
# Never commit the filled-in .env (.gitignore already blocks it).
# One OpenAI key covers both embeddings (the worker) and generation (answer_question).
# Other OpenAI-compatible providers (DeepSeek, OpenRouter) also need OPENAI_BASE_URL.
OPENAI_API_KEY=

# Your agent fetches this from Neon after it opens the dev branch (get_connection_string)
# and writes it here; the embedding worker and the RAG app read it. Leave blank to start.
# DATABASE_URL=
