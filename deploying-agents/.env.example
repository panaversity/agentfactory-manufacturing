# Copy to .env and fill in. The harness boots with ONLY OPENAI_API_KEY set;
# every other key unlocks one more piece of the stack.

# Required to run the agent loop.
OPENAI_API_KEY=sk-...

# Model. Defaults to gpt-5.4-mini (the SDK default) if unset.
# MAYA_MODEL=gpt-5.4-mini

# --- Sandbox (code execution). Set ONE of these to enable a sandbox. ---
# E2B has a free Hobby tier and is the easiest to test. Get a key at
# https://e2b.dev/dashboard
E2B_API_KEY=
# Cloudflare is the course's primary backend (needs a paid Workers plan and
# the bridge Worker). Set the bridge Worker URL here to use it instead.
# CLOUDFLARE_WORKER_URL=https://your-bridge.workers.dev

# --- Durable state. Absent -> SQLite file (./maya.db). ---
# Neon Postgres connection string. The app strips channel_binding for asyncpg.
# Use the direct (non-pooler) endpoint when running migrations.
DATABASE_URL=

# --- Artifact storage. Absent -> local ./artifacts directory. ---
# Cloudflare R2 (S3-compatible). All four must be set to enable R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
